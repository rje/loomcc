#!/bin/sh
# Builds loomcc and the runner (quietly, niced, two jobs) and runs the runner
# with the given arguments. The suite is tests/ in the loomcc workspace.
here=$(cd "$(dirname "$0")" && pwd)
nice_cmd=""
command -v taskpolicy >/dev/null 2>&1 && nice_cmd="taskpolicy -b nice -n 19"
(cd "$here/.." && CARGO_BUILD_JOBS=2 $nice_cmd cargo build -q -p loomcc -p loomcc-tests) || exit 2
exec "$here/../target/debug/loomcc-tests" "$@"
